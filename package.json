{
  "name": "fitapp",
  "version": "1.0.0",
  "description": "Tu compañero fitness personal",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "pack": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.ruben.fitapp",
    "productName": "FitApp",
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [{"target": "dmg", "arch": ["arm64", "x64"]}]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "electron/**",
      "!electron/node_modules"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
